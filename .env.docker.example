# ============================================================
# Docker 中间件环境变量（对应 docker-compose.yml）
# 复制为 .env 即可修改；不要把真实密码提交进 Git
# ============================================================

# MySQL
# 注意：如果你的 WSL2 / Windows 上有其他 MySQL 占用 3306，把 MYSQL_PORT 改成空闲端口（如 3307）
# 同步需要让后端用 SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/diancan-system?... 启动
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=diancan-system
MYSQL_PORT=3307

# Redis
REDIS_PASSWORD=123456
REDIS_PORT=6379

# RocketMQ
ROCKETMQ_NAMESRV_PORT=9876
ROCKETMQ_BROKER_PORT=10911
ROCKETMQ_BROKER_HA_PORT=10912

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=dish-images